}
/**
 * The shape of the {@link effectfulSchedulingNodesKey} hook.
 *
 * @internal
 * @since 1.3.0
 */
type EffectfulSchedulingNodesFn = (state: unknown, parentPath: readonly PropertyKey[] | undefined, options?: ExpandRuntimeNodesOptions) => readonly RuntimeNode[];
/**
 * Opt-in marker for parsers whose {@link effectfulSchedulingNodesKey}
